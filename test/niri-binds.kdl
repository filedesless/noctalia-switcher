// rcmd binds for the switcher. Right Super is ISO_Level3_Shift (xkb option
// lv3:rwin_switch). Paste inside binds { } in ~/.config/niri/config.kdl,
// replacing the old ISO_Level3_Shift+Space bind.
ISO_Level3_Shift+Space hotkey-overlay-title="Window switcher" { spawn "noctalia" "msg" "plugin" "filedesless/switcher:service" "all" "key" "space"; }
ISO_Level3_Shift+A hotkey-overlay-title=null { spawn "noctalia" "msg" "plugin" "filedesless/switcher:service" "all" "key" "a"; }
ISO_Level3_Shift+B hotkey-overlay-title=null { spawn "noctalia" "msg" "plugin" "filedesless/switcher:service" "all" "key" "b"; }
