#!/bin/sh
# A stand-in for niri, first on the test instance's PATH. It plays back
# test/events.jsonl as the event stream, answers `outputs`, and logs
# focus-window ids to $STUB_LOG instead of acting on them.
here=$(dirname "$0")
case "$*" in
  "msg --json event-stream")
    cat "$here/../events.jsonl"
    exec sleep infinity
    ;;
  "msg --json outputs")
    cat "$here/../outputs.json"
    ;;
  "msg action focus-window --id "*)
    echo "focus $5" >> "${STUB_LOG:?}"
    ;;
  *)
    echo "$*" >> "${STUB_LOG:?}"
    ;;
esac
